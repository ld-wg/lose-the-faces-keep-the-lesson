#!/usr/bin/env bash
# bin/video <anonymize-folder> [flags...]
#   Final video: generated faces pasted back, every other face box hidden
#   (fail-safe: the track's last generated face, or a neutral fill).
#   Writes <folder>/output.mp4 and <folder>/compose.jsonl.
#   flags  passed through to src.pipeline.phase2_generate.compose_video
#          (e.g. --failsafe off --out <folder>/output-exposed.mp4, diagnostic only)
source "$(dirname "$0")/_lib.sh"
[[ $# -ge 1 ]] || { sed -n '2,7p' "$0" >&2; exit 1; }

dir=$(cd "$1" && pwd); shift
[[ -f $dir/run_manifest.json ]] || die "$dir is not an anonymize folder (no run_manifest.json)"
det=$(json_get "$dir/run_manifest.json" phase1_dir)
video=$(json_get "$dir/run_manifest.json" video)

run "$dir" video uv run python -m src.pipeline.phase2_generate.compose_video \
  --phase1-dir "$det" --phase2-dir "$dir" --video "$video" --out "$dir/output.mp4" "$@"
